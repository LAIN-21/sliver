# Local development placeholders only. Copy to .env with `make install`.
# Do not put real secrets in this file.

COMPOSE_PROJECT_NAME=sliver

POSTGRES_USER=sliver
POSTGRES_PASSWORD=sliverdev
POSTGRES_DB=sliver
POSTGRES_PORT=5432

MINIO_ROOT_USER=sliver
MINIO_ROOT_PASSWORD=sliverdev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application metadata and private object storage. Keep these aligned with the
# infrastructure credentials and ports above when overriding local values.
DATABASE_URL=postgresql+psycopg://sliver:sliverdev@127.0.0.1:5432/sliver
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=sliver
S3_SECRET_ACCESS_KEY=sliverdev
S3_BUCKET=sliver-private
S3_REGION=us-east-1

# Loopback-only development UI; the API requires an allowed Origin and a
# session CSRF token for every mutation. Use secure cookies behind HTTPS.
SLIVER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_SECURE=false
SESSION_TTL_SECONDS=28800

# Set three distinct local demo passwords (at least 12 characters each) before
# explicitly seeding demo accounts. Empty values make seeding fail closed.
SLIVER_SELLER_A_PASSWORD=
SLIVER_SELLER_B_PASSWORD=
SLIVER_REVIEWER_PASSWORD=
