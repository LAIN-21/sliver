# Local development placeholders only. Copy to .env with `make install`.
# Do not put real secrets in this file.

COMPOSE_PROJECT_NAME=sliver

POSTGRES_USER=sliver
POSTGRES_PASSWORD=sliverdev
POSTGRES_DB=sliver
# Host port for PostgreSQL. 5433 avoids clashing with a PostgreSQL already installed on 5432.
POSTGRES_PORT=5433

MINIO_ROOT_USER=sliver
MINIO_ROOT_PASSWORD=sliverdev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application containers. DATABASE_URL and the S3 credentials are derived from the values above
# inside compose.yml, so they are not repeated here.
SLIVER_API_PORT=8000
SLIVER_WEB_PORT=5173
S3_BUCKET=sliver-private
S3_REGION=us-east-1

# x402 payments on XRPL Testnet (ADR 0004). Mainnet is refused.
# FACILITATOR_URL may also be https://x402.org/facilitator (official, open source).
FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234/
# Illustrative USD-to-XRP demo rate: drops per US dollar (400000 drops = 0.4 XRP, i.e. 1 XRP = 2.50 USD).
DROPS_PER_USD=400000
# Sliver collects every sale and pays sellers every 15 days (ADR 0005). Buyers pay the platform wallet.
# `make wallets` creates it (faucet-funded, Testnet only) and appends its seed (SLIVER_PLATFORM_SEED,
# kept for future payouts; the API never reads it) and SLIVER_PLATFORM_ADDRESS. Without the address,
# purchases answer 503. Only set it by hand to the address of SLIVER_PLATFORM_SEED.
# SLIVER_PLATFORM_ADDRESS=
# Sliver's platform fee in basis points: 1000 = 10%, allowed 0-5000. Kept from each sale; the rest is
# the seller's net, paid out on the 1st and 16th of each month (UTC).
SLIVER_PLATFORM_FEE_BPS=1000

# Demo accounts, set by `make seed`. Every demo seller in examples/datasets/manifest.toml signs in
# with SLIVER_SELLER_PASSWORD; the reviewer signs in as reviewer@sliver.local. An empty value leaves
# those accounts unable to sign in. Choose your own local passwords; never reuse real ones.
SLIVER_SELLER_PASSWORD=
SLIVER_REVIEWER_PASSWORD=
# Browser origins allowed to send mutations (POST/PUT/PATCH/DELETE), comma-separated. Update it if
# you change SLIVER_WEB_PORT. Requests without an allowed Origin header are refused.
SLIVER_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Server-side sign-in sessions (HttpOnly, SameSite=Lax cookie). Set the cookie Secure behind https.
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
# Per-IP request budgets per minute, kept in the API process's memory. Over budget answers 429 with
# Retry-After. Login, uploads, catalog search and unpaid data requests (402 challenges) each have
# their own budget; requests that carry a payment signature are never limited.
SLIVER_RATE_LIMIT_ENABLED=true
SLIVER_RATE_LIMIT_LOGIN_PER_MINUTE=20
SLIVER_RATE_LIMIT_UPLOAD_PER_MINUTE=20
SLIVER_RATE_LIMIT_SEARCH_PER_MINUTE=300
SLIVER_RATE_LIMIT_PAYMENT_PER_MINUTE=120
# Custom-slice quotes (GET /api/resources/{id}/slices) cut and may store a new object each.
SLIVER_RATE_LIMIT_SLICE_QUOTE_PER_MINUTE=20
# Reverse proxies (IPs or CIDR ranges, comma-separated) whose X-Forwarded-For header is trusted.
# Leave empty when clients reach the API directly; never list addresses clients control.
SLIVER_TRUSTED_PROXIES=
# The worker deletes raw catalog search events older than this many days (at least 30).
SEARCH_EVENT_RETENTION_DAYS=90

# AI review of seller uploads. Optional: without ANTHROPIC_API_KEY the pipeline uses a deterministic
# offline fallback. With it, Claude sees each upload's schema, column profile and at most 20 sample
# rows (privacy-flagged cells redacted). Never commit a real key.
ANTHROPIC_API_KEY=
SLIVER_AI_MODEL=claude-opus-5-5
# Also ask Claude, with web search, whether equivalent data is freely available (needs the key).
SLIVER_AI_RESEARCH=false
# Datasets without blocking findings are accepted automatically at or above this quality score (0-100).
SLIVER_AUTO_ACCEPT_QUALITY=70

# `make wallets` appends faucet-funded Testnet wallet seeds below (SLIVER_WALLET_<SELLER>_SEED and
# SLIVER_DEMO_BUYER_SEED). They are testnet-only; the API never reads the buyer seed.
