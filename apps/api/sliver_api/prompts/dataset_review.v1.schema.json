{
  "name": "submit_review",
  "description": "Submit the review of the dataset: public listing metadata, concerns and the proposed slice column.",
  "input_schema": {
    "type": "object",
    "properties": {
      "category": {"type": "string"},
      "tags": {"type": "array", "items": {"type": "string"}},
      "title": {"type": "string"},
      "description": {"type": "string"},
      "quality_concerns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "column": {"type": "string"},
            "severity": {"type": "string", "enum": ["low", "medium"]},
            "message": {"type": "string"}
          },
          "required": ["column", "severity", "message"],
          "additionalProperties": false
        }
      },
      "sensitivity_concerns": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "column": {"type": "string"},
            "severity": {"type": "string", "enum": ["low", "medium", "high"]},
            "message": {"type": "string"}
          },
          "required": ["column", "severity", "message"],
          "additionalProperties": false
        }
      },
      "slice": {
        "type": "object",
        "properties": {
          "column": {"type": "string"},
          "period": {"type": "string", "enum": ["value", "month", "none"]}
        },
        "required": ["column", "period"],
        "additionalProperties": false
      }
    },
    "required": ["category", "tags", "title", "description", "quality_concerns", "sensitivity_concerns", "slice"],
    "additionalProperties": false
  }
}
